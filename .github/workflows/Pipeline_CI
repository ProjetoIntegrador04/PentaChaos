# Nome do pipeline (como aparecerá na aba "Actions" do GitHub)
name: CI Pipeline - Build, Testes e Docker

# Define quando o pipeline é executado
on:
  push:
    branches: [ main, develop, feature/** ]  # Executa ao fazer push nessas branches
  pull_request:
    branches: [ main, develop ]              # Executa também ao abrir PRs

# Definição dos "jobs" (etapas do pipeline)
jobs:
  build-test:
    runs-on: ubuntu-latest                   # Sistema operacional do runner

    # Serviços auxiliares (containers usados durante o build/teste)
    services:
      postgres:                              # Banco de dados para testes
        image: postgres:15-alpine
        env:
          POSTGRES_DB: test_db
          POSTGRES_USER: test_user
          POSTGRES_PASSWORD: test_pass
        ports:
          - 5432:5432
        options: >-
          --health-cmd="pg_isready -U test_user -d test_db"
          --health-interval=10s
          --health-timeout=5s
          --health-retries=5

    steps:
      # -----------------------------
      # 1️⃣ Baixa o código do repositório
      # -----------------------------
      - name: Checkout do código
        uses: actions/checkout@v4

      # -----------------------------
      # 2️⃣ Configura o Java 24 (Temurin)
      # -----------------------------
      - name: Configurar JDK 24
        uses: actions/setup-java@v4
        with:
          java-version: '24'                 # Sua versão do Java
          distribution: 'temurin'
          cache: 'maven'                     # Cacheia dependências do Maven

      # -----------------------------
      # 3️⃣ Cria um arquivo .env para simular ambiente local de testes
      # -----------------------------
      - name: Criar arquivo .env
        run: |
          echo "POSTGRES_DB=test_db" >> .env
          echo "POSTGRES_USER=test_user" >> .env
          echo "POSTGRES_PASSWORD=test_pass" >> .env
          echo "JWT_SECRET_KEY=test_secret" >> .env
          echo "JWT_EXPIRATION=3600000" >> .env
          echo "JWT_REFRESH_EXPIRATION=86400000" >> .env

      # -----------------------------
      # 4️⃣ Sobe o banco de dados do Docker Compose (se existir)
      # -----------------------------
      - name: Subir banco via Docker Compose
        run: docker compose up -d db

      # -----------------------------
      # 5️⃣ Aguarda o banco estar pronto
      # -----------------------------
      - name: Aguardar inicialização do banco
        run: sleep 15

      # -----------------------------
      # 6️⃣ Compila o projeto (gera o .jar)
      # -----------------------------
      - name: Build Maven (sem testes)
        run: ./mvnw -f ./pom.xml clean package -DskipTests

      # -----------------------------
      # 7️⃣ Executa os testes automatizados
      # -----------------------------
      - name: Rodar testes Maven
        run: ./mvnw -f ./pom.xml test

      # -----------------------------
      # 8️⃣ Faz o build da imagem Docker local
      # -----------------------------
      - name: Build da imagem Docker
        run: docker build -t penta-chaos-app .

      # -----------------------------
      # 9️⃣ Mostra os containers em execução (debug)
      # -----------------------------
      - name: Listar containers em execução
        run: docker ps -a

      # -----------------------------
      # 🔟 Finaliza os containers após o build
      # -----------------------------
      - name: Encerrar serviços Docker
        if: always()
        run: docker compose down
