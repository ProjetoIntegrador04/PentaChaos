<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <!-- O parent deve ser o seu módulo P_I, que gerencia as versões -->
        <groupId>projeto_integrador</groupId>
        <artifactId>P_I</artifactId>
        <version>0.0.1-SNAPSHOT</version> <!-- A versão do seu P_I -->
    </parent>

    <groupId>projeto_integrador</groupId>
    <artifactId>iam</artifactId>
    <version>0.0.1-SNAPSHOT</version> <!-- Mantenha a mesma versão do P_I para consistência -->
    <name>iam</name>
    <description>Módulo de Gerenciamento de Identidade e Acesso (IAM)</description>

    <properties>
        <!-- Não é estritamente necessário definir java.version aqui, pois já está no P_I, -->
        <!-- mas pode ser útil para garantir que IDEs reconheçam a versão correta do módulo. -->
        <!-- **Certifique-se que esta versão é compatível com a do P_I!** -->
        <java.version>24</java.version>
    </properties>

    <dependencies>
        <!-- Dependências do Spring Boot - suas versões são herdadas de P_I/dependencyManagement -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Driver do seu banco de dados (ex: PostgreSQL) -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Lombok (Opcional) -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Dependências de teste -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip> <!-- Crucial: impede que este módulo tente ser uma app boot independente -->
                    <classifier>exec</classifier>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>