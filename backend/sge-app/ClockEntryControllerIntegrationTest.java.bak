package com.sge.sge_app;

import com.fasterxml.jackson.databind.ObjectMapper;
import com.sge.sge_app.dto.request.ClockEntryRequest;
import com.sge.sge_app.dto.response.ClockEntryResponse;
import com.sge.sge_app.services.ClockEntryService;
import org.junit.jupiter.api.DisplayName;
import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.test.autoconfigure.web.servlet.WebMvcTest;
import org.springframework.boot.test.mock.mockito.MockBean;
import org.springframework.http.MediaType;
import org.springframework.security.test.context.support.WithMockUser;
import org.springframework.test.web.servlet.MockMvc;

import java.time.LocalDateTime;

import static org.mockito.ArgumentMatchers.any;
import static org.mockito.Mockito.when;
import static org.springframework.security.test.web.servlet.request.SecurityMockMvcRequestPostProcessors.csrf;
import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.*;
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.*;

@WebMvcTest(controllers = ClockEntryController.class)
@DisplayName("ClockEntry Controller Integration Tests")
class ClockEntryControllerIntegrationTest {

    @Autowired
    private MockMvc mockMvc;

    @MockBean
    private ClockEntryService clockEntryService;

    @Autowired
    private ObjectMapper objectMapper;

    @Test
    @DisplayName("POST /api/v1/clockentries - Deve registrar ponto com sucesso")
    @WithMockUser(username = "testuser", roles = {"USER"})
    void deveRegistrarPontoComSucesso() throws Exception {
        // Given
        ClockEntryRequest request = ClockEntryRequest.builder()
                .tipo("ENTRY")
                .timestamp(LocalDateTime.now())
                .latitude(-23.550520f)
                .longitude(-46.633308f)
                .precisao(10.5f)
                .fonte("WEB")
                .deviceId("device123")
                .build();

        ClockEntryResponse response = ClockEntryResponse.builder()
                .id(1L)
                .userId(1L)
                .tipo("ENTRY")
                .timestamp(LocalDateTime.now())
                .latitude(-23.550520f)
                .longitude(-46.633308f)
                .precisao(10.5f)
                .fonte("WEB")
                .deviceId("device123")
                .ip("127.0.0.1")
                .createdAt(LocalDateTime.now())
                .build();

        when(clockEntryService.registrarPonto(any(ClockEntryRequest.class), any()))
                .thenReturn(response);

        // When & Then
        mockMvc.perform(post("/api/v1/clockentries")
                        .with(csrf())
                        .contentType(MediaType.APPLICATION_JSON)
                        .content(objectMapper.writeValueAsString(request)))
                .andExpect(status().isCreated())
                .andExpect(jsonPath("$.id").value(1L))
                .andExpect(jsonPath("$.tipo").value("ENTRY"));
    }

    @Test
    @DisplayName("POST /api/v1/clockentries - Deve falhar sem autenticação")
    void deveFalharSemAutenticacao() throws Exception {
        ClockEntryRequest request = ClockEntryRequest.builder()
                .tipo("ENTRY")
                .build();

        mockMvc.perform(post("/api/v1/clockentries")
                        .with(csrf())
                        .contentType(MediaType.APPLICATION_JSON)
                        .content(objectMapper.writeValueAsString(request)))
                .andExpect(status().isUnauthorized());
    }

    @Test
    @DisplayName("GET /api/v1/clockentries/{id} - Deve buscar ponto por ID")
    @WithMockUser(username = "testuser", roles = {"USER"})
    void deveBuscarPontoPorId() throws Exception {
        // Given
        ClockEntryResponse response = ClockEntryResponse.builder()
                .id(1L)
                .userId(1L)
                .tipo("ENTRY")
                .build();

        when(clockEntryService.buscarPontoPorId(1L)).thenReturn(response);

        // When & Then
        mockMvc.perform(get("/api/v1/clockentries/1"))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.id").value(1L));
    }
}