    fontWeight: 'bold', 
    color: 'white', 
    textAlign: 'center', 
    marginTop: 20,
  },
  screenSubtitle: {
    fontSize: 14,
    color: 'rgba(255, 255, 255, 0.8)',
    textAlign: 'center',
    marginTop: 8,
    textTransform: 'capitalize',
  },
